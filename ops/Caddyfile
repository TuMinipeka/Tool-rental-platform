{
    email {$ACME_EMAIL}
    admin off
}
{$PUBLIC_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @backend path /api /api/* /swagger-ui.html /swagger-ui/* /v3/api-docs /v3/api-docs/* /status/database
    handle @backend {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:80
    }
}
