COMPOSE_PROJECT_NAME=tool-rental-platform

POSTGRES_IMAGE=postgres:17.11-alpine
POSTGRES_DB=tool_rental
POSTGRES_USER=tool_rental
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

SPRING_PROFILES_ACTIVE=local,demo
DB_URL=jdbc:postgresql://localhost:5432/tool_rental
DB_USERNAME=tool_rental
DB_PASSWORD=change-me-for-local-development
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

BACKEND_PORT=8080
NODE_IMAGE=node:24.22.0-alpine
NGINX_IMAGE=nginx:1.30.6-alpine-slim
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_MODE=true

# Local-only defaults. Public settings belong in .env.showcase.
JWT_SECRET=local-development-secret-change-before-production-2026
CORS_ALLOWED_ORIGINS=http://localhost:5173
PAYMENT_PROVIDER=fictional
# Optional backend-only Mercado Pago credentials for an external integration.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENTS_PUBLIC_URL=
