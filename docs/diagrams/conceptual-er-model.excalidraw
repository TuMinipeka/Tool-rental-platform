      "locked": false,
      "text": "1. Rectangles: entities with business attributes. Diamonds: relationships. No SQL types or foreign keys.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Rectangles: entities with business attributes. Diamonds: relationships. No SQL types or foreign keys.",
      "autoResize": true,
      "lineHeight": 1.3,
      "index": "b3y"
