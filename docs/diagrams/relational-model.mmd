    users ||--o{ reservation_terminations : "reservation_terminations_requested_by_fkey"
    reservations ||--o{ reservation_terminations : "reservation_terminations_reservation_id_fkey"
    users |o--o{ reservation_terminations : "reservation_terminations_resolved_by_fkey"
    cancellation_policies ||--o{ reservations : "reservations_cancellation_policy_id_fkey"
    customers ||--o{ reservations : "reservations_customer_id_fkey"
    delivery_rates |o--o{ reservations : "reservations_delivery_rate_id_fkey"
    users ||--o| suppliers : "suppliers_user_id_fkey"
    tools ||--o{ tool_images : "tool_images_tool_id_fkey"
    categories ||--o{ tools : "tools_category_id_fkey"
    suppliers ||--o{ tools : "tools_supplier_id_fkey"
    reservation_items ||--o| unit_deliveries : "unit_deliveries_item"
    unit_deliveries ||--o| unit_returns : "unit_returns_delivery"
    roles ||--o{ user_roles : "user_roles_role_id_fkey"
    users ||--o{ user_roles : "user_roles_user_id_fkey"
    user_sessions |o--o{ user_sessions : "user_sessions_replaced_by_session_id_fkey"
    users ||--o{ user_sessions : "user_sessions_user_id_fkey"
